# Server Configuration
PORT=5000

# Gmail SMTP & App Password Credentials
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-agency-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Target Inbox to Receive Customer Inquiries (defaults to GMAIL_USER if blank)
NOTIFICATION_RECEIVER=your-agency-email@gmail.com
