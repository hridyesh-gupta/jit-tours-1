# Server Configuration
PORT=5000

# Used only by the local Express dev server (server.js) to print the correct
# frontend link on its status page. Not required on Vercel.
FRONTEND_URL=http://localhost:3000

# Gmail SMTP & App Password Credentials
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# (Regular Gmail account passwords will NOT work here — it must be an App Password.)
GMAIL_USER=jitsonker2004@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Inbox that receives the "new enquiry" alert email (defaults to GMAIL_USER if left blank)
NOTIFICATION_RECEIVER=jitsonker2004@gmail.com

# ---------------------------------------------------------------------------
# Neon Database
# Every enquiry is saved to a Neon Postgres "enquiries" table (in addition
# to the two emails). Get this connection string from your Neon project's
# dashboard: Connection Details -> "Pooled connection". It looks like:
# postgresql://<user>:<password>@<host>.neon.tech/<database>?sslmode=require
#
# After setting this, run `npm run db:setup` once to create the table.
# If DATABASE_URL is left blank, the site still works fine — enquiries are
# just emailed and not saved anywhere.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Admin Panel (yoursite.com/admin)
# Shows every customer enquiry saved to the database above, behind a
# username/password login. Pick your own username and a strong password —
# these are not pre-set to anything by default, so the admin panel simply
# refuses all logins until you fill these in.
#
# ADMIN_SESSION_SECRET is a separate random string used only to sign login
# sessions (not a password you type in) — any long random text works, e.g.
# generate one with: openssl rand -hex 32
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string
