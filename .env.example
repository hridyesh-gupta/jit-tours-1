# Server Configuration
PORT=5000

# Used only by the local Express dev server (server.js) to print the correct
# frontend link on its status page. Not required on Vercel.
FRONTEND_URL=http://localhost:3000

# Gmail SMTP & App Password Credentials
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# (Regular Gmail account passwords will NOT work here — it must be an App Password.)
GMAIL_USER=your-agency-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Inbox that receives the "new enquiry" alert email (defaults to GMAIL_USER if left blank)
NOTIFICATION_RECEIVER=your-agency-email@gmail.com

# ---------------------------------------------------------------------------
# Database (not wired up yet)
# The site currently only emails enquiries — it does not save them anywhere.
# Add your connection string here once you set up your own database, then
# update api/inquiry.js (and server.js) to write each enquiry to it.
# ---------------------------------------------------------------------------
# DATABASE_URL=
